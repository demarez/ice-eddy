    "def coriolis_frequency(latitude_degrees):\n",
    "    import math\n",
    "    omega = 7.2921e-5  # Earth's angular velocity (rad/s)\n",
    "    phi_rad = math.radians(latitude_degrees)\n",
    "    f0 = 2 * omega * math.sin(phi_rad)\n",
    "    return f0\n",
    "\n",
